# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/digitaltau?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-key-change-in-production"

# Seed Admin User
SEED_ADMIN_EMAIL="admin@digitaltau.local"
SEED_ADMIN_PASSWORD="admin123"

# Docker Postgres (optional, used by docker-compose)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="digitaltau"
